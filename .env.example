# ── Server Configuration ───────────────────────────────────────────────────────
# Port for the web application (default: 6798)
PORT=6798

# Runtime environment (default: production)
NODE_ENV=production

# ── Security & Authentication ──────────────────────────────────────────────────
# Required in production: Secret key for signing session cookies.
# The server will refuse to start in production if this is empty.
# Generate a secure key using: openssl rand -hex 32
SESSION_SECRET=

# Trust reverse proxy headers (X-Forwarded-Proto, X-Forwarded-For).
# Set to 'true' or '1' when behind an HTTPS reverse proxy like Nginx.
TRUST_PROXY=true

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite database file path (default: ./data/planner.db)
DATABASE_URL=./data/planner.db
