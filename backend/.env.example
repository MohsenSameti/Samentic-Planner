# Backend environment configuration.
#
# Copy this file to `.env` (gitignored) and edit as needed. The
# server reads DATABASE_URL on startup and resolves relative
# paths against the backend's working directory.

# SQLite database location. Examples:
#   DATABASE_URL=:memory:                      (in-memory; tests)
#   DATABASE_URL=./data/planner.db             (relative; default)
#   DATABASE_URL=/var/lib/planner/planner.db   (absolute)
#   DATABASE_URL=file:./data/planner.db        (Drizzle convention)
DATABASE_URL=./data/planner.db

# Server port (default 3000 if unset).
# PORT=3000